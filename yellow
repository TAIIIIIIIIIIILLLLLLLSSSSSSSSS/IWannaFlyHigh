    case 'ball':addMat(group,new THREE.SphereGeometry(1,48,36),0x1687ff,.12,.3);break;
    case 'electronics':{const body=roundedBox(group,2.2,.28,3.4,0x343d45);body.rotation.x=-.18;const screen=roundedBox(group,1.9,.04,2.9,0x1687ff);screen.position.y=.18;screen.position.z=.01;break;}
    case 'book':{const base=roundedBox(group,2.2,.42,3.0,0x82352a);const pages=roundedBox(group,1.96,.34,2.82,0xf2efe7);pages.position.y=.35;break;}
    case 'watch':addMat(group,new THREE.CylinderGeometry(.92,.92,.20,48),0x242a30,.75,.18);addMat(group,new THREE.CylinderGeometry(.72,.72,.05,48),0xf3f3f3,.2,.3).position.y=.13;break;
    case 'tool':{const head=roundedBox(group,1.05,.8,1.1,0x68747b);head.position.y=.68;const handle=addMat(group,new THREE.CylinderGeometry(.23,.28,2.55,28),0x8a541e,.1,.4);handle.position.y=-.58;break;}
    case 'box':roundedBox(group,2.0,1.7,2.0,0xb77b30);break;
    case 'can':addMat(group,new THREE.CylinderGeometry(.58,.58,1.75,48),0xf01f32,.55,.2);addMat(group,new THREE.CylinderGeometry(.54,.54,.055,48),0xd5d9dd,.8,.2).position.y=.91;break;
    case 'rice':{const g=new THREE.SphereGeometry(1,24,16);const m=addMat(group,g,0xf4e5c8,.02,.48);m.scale.set(.38,.16,1.25);m.rotation.z=.25;break;}
    case 'coin':{const o=addMat(group,new THREE.CylinderGeometry(1,1,.18,64),0xd7b23a,.75,.2);o.rotation.x=Math.PI/2;const r=addMat(group,new THREE.TorusGeometry(.83,.04,12,48),0x8e6718,.65,.18);r.rotation.x=Math.PI/2;break;}
    case 'dish':{const d=addMat(group,new THREE.CylinderGeometry(1.1,1.0,.18,64),0xe9edf0,.1,.32);d.scale.y=.5;break;}
    case 'shoe':{const sole=roundedBox(group,2.3,.25,4.7,0xe7e9eb);sole.position.y=-.45;const upper=roundedBox(group,2,.9,3.9,0xffb900);upper.position.y=.05;upper.rotation.y=-.12;break;}
    default:createSilhouetteModel(group,stats);
  }
}

let silhouetteStats=null;
let renderResizeObserver=null;
let renderGeneration=0;

function getRenderHost(){
  return document.querySelector('.render');
}

function getRenderSize(host){
  const rect=host.getBoundingClientRect();
  return {
    w:Math.max(320,Math.round(rect.width||320)),
    h:Math.max(220,Math.round(rect.height||330))
  };
}

function reset3DCanvas(){
  const host=getRenderHost();
  if(!host) return null;
  if(renderResizeObserver){renderResizeObserver.disconnect();renderResizeObserver=null;}
  if(renderer){
    try{renderer.setAnimationLoop(null);}catch(e){}
    try{renderer.dispose();}catch(e){}
    try{renderer.forceContextLoss?.();}catch(e){}
    renderer=null;
  }
  host.innerHTML='';
  const canvas=document.createElement('canvas');
  canvas.id='threeCanvas';
  canvas.style.width='100%';
  canvas.style.height='100%';
  canvas.style.display='block';
  host.appendChild(canvas);
  return canvas;
}

function resize3D(){
  if(!renderer||!camera)return;
  const host=getRenderHost();
  const canvas=document.querySelector('#threeCanvas');
  if(!host||!canvas)return;
  const {w,h}=getRenderSize(host);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  renderer.setSize(w,h,false);
  camera.aspect=w/h;
  camera.updateProjectionMatrix();
  renderer.render(scene,camera);
}

function inferArchivedModel(x){
  if(x && x.model) return x.model;
  const text=((x?.name||'')+' '+(x?.category||'')).toLowerCase();
  if(/rice|grain/.test(text)) return 'rice';
  if(/cup|mug|drinkware/.test(text)) return 'cup';
  if(/bottle|thermos|flask/.test(text)) return 'bottle';
  if(/phone|smartphone|laptop|electronic/.test(text)) return 'electronics';
  if(/book|printed/.test(text)) return 'book';
  if(/shoe|boot|footwear/.test(text)) return 'shoe';
  if(/ball|sport/.test(text)) return 'ball';
  if(/watch|clock|timepiece/.test(text)) return 'watch';
  if(/hammer|wrench|screwdriver|tool/.test(text)) return 'tool';
  if(/can|beverage/.test(text)) return 'can';
  if(/coin/.test(text)) return 'coin';
  if(/dish|plate/.test(text)) return 'dish';
  if(/box|container/.test(text)) return 'box';
  return 'silhouette';
}

function init3D(type='silhouette',stats=null,attempt=0){
  silhouetteStats=stats;
  const host=getRenderHost();
  if(!host)return;

  // The archive page can trigger this while the scanner panel is still in the
  // middle of a layout transition. Do not initialize WebGL against a zero-sized
  // container; retry for a short window instead.
  const rect=host.getBoundingClientRect();
  if(rect.width<100 || rect.height<100){
    if(attempt<40) setTimeout(()=>init3D(type,stats,attempt+1),50);
    return;
  }

  const thisGeneration=++renderGeneration;
  const canvas=reset3DCanvas();
  if(!canvas)return;
  const size=getRenderSize(host);

  scene=new THREE.Scene();
  scene.background=new THREE.Color(0x040b14);

  camera=new THREE.PerspectiveCamera(42,size.w/size.h,.01,1000);
  camera.position.set(0,0,6);

  try{
    renderer=new THREE.WebGLRenderer({canvas,antialias:true,alpha:false,preserveDrawingBuffer:false});
  }catch(err){
    console.error('Tails Industries WebGL initialization failed:',err);
    host.innerHTML='<div style="height:100%;display:grid;place-items:center;color:#7891aa;font-size:12px">3D RENDER UNAVAILABLE IN THIS BROWSER</div>';
    return;
  }
  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  renderer.setSize(size.w,size.h,false);
  renderer.outputColorSpace=THREE.SRGBColorSpace;

  scene.add(new THREE.HemisphereLight(0xe1efff,0x172235,2.4));
  const key=new THREE.DirectionalLight(0xffffff,3.5);key.position.set(4,7,6);scene.add(key);
  const fill=new THREE.PointLight(0xffd21a,1.2,10);fill.position.set(-3,2,3);scene.add(fill);

  const group=new THREE.Group();
  createModel(group,type,stats);
  scene.add(group);

  // Only add the presentation ring after the model exists.
  const ring=new THREE.Mesh(
    new THREE.TorusGeometry(1.35,.025,12,64),
    new THREE.MeshBasicMaterial({color:0xffd83d})
  );
  ring.rotation.x=Math.PI/2;
  group.add(ring);

  const grid=new THREE.GridHelper(10,20,0x17334d,0x0d2033);
  grid.position.y=-1.35;
  scene.add(grid);

  // Compute the true bounds of the generated model and frame the camera around
  // those bounds. This works for both procedural models and silhouette models.
  const box=new THREE.Box3().setFromObject(group);
  const center=box.getCenter(new THREE.Vector3());
  group.position.sub(center);
  box.setFromObject(group);
  const sphere=box.getBoundingSphere(new THREE.Sphere());
  const radius=Math.max(.35,sphere.radius);
  const distance=Math.max(3.8,radius/Math.sin(THREE.MathUtils.degToRad(camera.fov*.5))*1.22);

  camera.near=Math.max(.01,distance/200);
  camera.far=Math.max(100,distance*20);
  camera.position.set(distance*.55,distance*.32,distance);
  camera.lookAt(0,0,0);
  camera.updateProjectionMatrix();
  renderer.render(scene,camera);

  renderResizeObserver=new ResizeObserver(()=>resize3D());
  renderResizeObserver.observe(host);

  const animate=()=>{
    if(thisGeneration!==renderGeneration || !renderer)return;
    renderer._tailsRAF=requestAnimationFrame(animate);
    group.rotation.y+=.006;
    group.rotation.x=Math.sin(Date.now()*.0005)*.035;
    renderer.render(scene,camera);
  };
  animate();
}

function loadHistory(){
  const items=JSON.parse(localStorage.getItem('tailsArchive')||'[]');$('#count').textContent=items.length?`(${items.length})`:'';const grid=$('#historyGrid');
  if(!items.length){grid.innerHTML='<div class="empty">ARCHIVE EMPTY<br><small>Run a scan to create the first database entry.</small></div>';return;}
  grid.innerHTML=items.map((x,i)=>`<div class="history-card" data-i="${i}"><img src="${x.image}" alt=""><div class="history-info"><strong>${escapeHtml(x.name)}</strong><span>${x.worth} • ${x.date}</span></div></div>`).join('');grid.querySelectorAll('.history-card').forEach(c=>c.onclick=()=>showRecord(items[+c.dataset.i]));
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));}

document.querySelectorAll("nav button").forEach(b=>b.onclick=()=>{
  document.querySelectorAll("nav button").forEach(x=>x.classList.remove("active"));b.classList.add("active");
  document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));$("#"+b.dataset.view).classList.add("active");
});
$("#clear").onclick=()=>{if(confirm("Delete all archived scans from this browser?")){localStorage.removeItem("tailsArchive");loadHistory()}};
window.addEventListener('resize',resize3D);
loadHistory();
</script>

<script>
(() => {
  const ACCESS_CODE='1992';
  let audioCtx=null;
  function audio(){
    try{
      const C=window.AudioContext||window.webkitAudioContext;
      if(!C)return null;
      if(!audioCtx) audioCtx=new C();
      if(audioCtx.state==='suspended') audioCtx.resume();
      return audioCtx;
    }catch(e){return null}
  }
  function tone(freq1,freq2,dur,vol,type='square',delay=0){
    const c=audio(); if(!c)return;
    const o=c.createOscillator(), g=c.createGain(), t=c.currentTime+delay;
    o.type=type; o.frequency.setValueAtTime(freq1,t);
    if(freq2) o.frequency.exponentialRampToValueAtTime(freq2,t+dur);
    g.gain.setValueAtTime(.0001,t); g.gain.exponentialRampToValueAtTime(vol,t+.008); g.gain.exponentialRampToValueAtTime(.0001,t+dur);
    o.connect(g); g.connect(c.destination); o.start(t); o.stop(t+dur+.03);
  }
  function clickSound(){tone(720,1050,.055,.035,'square')}
  function confirmSound(){tone(520,780,.09,.045,'square');tone(780,1180,.13,.035,'square',.08)}
  function denySound(){tone(230,120,.18,.045,'sawtooth')}
  function scanSound(){tone(350,900,.35,.025,'triangle')}

  // Visible click sounds, including the password button and all site controls.
  document.addEventListener('pointerdown',e=>{
    const el=e.target.closest('button,[role="button"],.drop,.history-card,input[type="file"],nav');
    if(el && !el.disabled) clickSound();
  },true);

  // Expose small sound API to the existing database code.
  window.tailsSounds={click:clickSound,confirm:confirmSound,deny:denySound,scan:scanSound};

  const gate=document.getElementById('passwordGate');
  const input=document.getElementById('pinInput');
  const button=document.getElementById('unlockBtn');
  const msg=document.getElementById('gateMessage');
  const dots=[1,2,3,4].map(i=>document.getElementById('dot'+i));

  function update(){
    const n=input.value.length;
    dots.forEach((d,i)=>d.classList.toggle('filled',i<n));
    button.disabled=n!==4;
  }
  function unlock(){
    if(input.value===ACCESS_CODE){
      confirmSound();
      gate.classList.add('hidden');
      document.body.classList.remove('locked');
      msg.textContent='ACCESS GRANTED';
      input.blur();
    }else{
      denySound();
      msg.textContent='ACCESS DENIED — INVALID 4-DIGIT CODE';
      input.value=''; update(); input.focus();
    }
  }
  input.addEventListener('input',()=>{input.value=input.value.replace(/\D/g,'').slice(0,4);msg.textContent='';update()});
  input.addEventListener('keydown',e=>{if(e.key==='Enter' && input.value.length===4)e.preventDefault()});
  button.addEventListener('click',unlock);
  update();
  setTimeout(()=>input.focus(),150);
})();
</script>

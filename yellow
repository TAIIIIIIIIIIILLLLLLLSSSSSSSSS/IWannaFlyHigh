function addMat(group,geo,color=0xffb900,metalness=.28,roughness=.32){const mat=new THREE.MeshStandardMaterial({color,metalness,roughness});const obj=new THREE.Mesh(geo,mat);group.add(obj);return obj;}
function roundedBox(group,w,h,d,color=0xffb900){return addMat(group,new THREE.BoxGeometry(w,h,d),color,.25,.35);}

function createSilhouetteModel(group,stats){
  if(!stats){const b=roundedBox(group,1.7,1.1,1.2,0xffb900);return b;}
  const {w,h,mask,bbox}=stats;const cx=bbox.x+bbox.width/2,cy=bbox.y+bbox.height/2;
  const pts=[];const samples=96;
  for(let i=0;i<samples;i++){
    const ang=(i/samples)*Math.PI*2;let found=null;
    for(let r=1;r<Math.max(w,h);r+=1){const x=Math.round(cx+Math.cos(ang)*r),y=Math.round(cy+Math.sin(ang)*r);if(x<0||x>=w||y<0||y>=h)break;if(mask[y*w+x])found=[x,y];}
    if(found)pts.push({x:(found[0]-cx)/Math.max(1,bbox.height)*3.0,y:-(found[1]-cy)/Math.max(1,bbox.height)*3.0});
  }
  if(pts.length<10){roundedBox(group,2,1.2,1.1,0xffb900);return;}
  const shape=new THREE.Shape();shape.moveTo(pts[0].x,pts[0].y);for(let i=1;i<pts.length;i++)shape.lineTo(pts[i].x,pts[i].y);shape.closePath();
  const geo=new THREE.ExtrudeGeometry(shape,{depth:.7,bevelEnabled:true,bevelSize:.045,bevelThickness:.045,bevelSegments:2});geo.center();
  const hue=stats.avg;const col=(Math.round(hue[0])<<16)|(Math.round(hue[1])<<8)|Math.round(hue[2]);
  const m=addMat(group,geo,col,.22,.42);m.rotation.x=-Math.PI/2;
  group.userData.silhouette=true;
}


}

function analyzePixels(c,ctx){
  const w=c.width,h=c.height,data=ctx.getImageData(0,0,w,h).data;
  const corners=[[1,1],[w-2,1],[1,h-2],[w-2,h-2]];
  const bg=corners.map(([x,y])=>{const i=(y*w+x)*4;return [data[i],data[i+1],data[i+2]];});
  const bgAvg=bg.reduce((a,b)=>a.map((v,i)=>v+b[i]/bg.length),[0,0,0]);
  const mask=new Uint8Array(w*h);
  let sum=0,count=0,minX=w,minY=h,maxX=0,maxY=0;
  for(let y=1;y<h-1;y++)for(let x=1;x<w-1;x++){
    const i=(y*w+x)*4;const r=data[i],g=data[i+1],b=data[i+2],a=data[i+3]/255;
    const d=Math.hypot(r-bgAvg[0],g-bgAvg[1],b-bgAvg[2]);
    const local=((r+g+b)/3);
    const edge=Math.abs(local-(data[((y-1)*w+x)*4]+data[((y+1)*w+x)*4]+data[(y*w+x-1)*4]+data[(y*w+x+1)*4]+data[((y)*w+x)*4])/5/1);
    const on=a>.02 && (d>28 || edge>18);
    if(on){mask[y*w+x]=1;sum+=d;count++;minX=Math.min(minX,x);minY=Math.min(minY,y);maxX=Math.max(maxX,x);maxY=Math.max(maxY,y);}
  }
  const area=(maxX>=minX)?(maxX-minX+1)*(maxY-minY+1):1;
  const fill=count/Math.max(1,area);
  const samples=[]; for(let y=0;y<h;y+=Math.max(1,Math.floor(h/24))) for(let x=0;x<w;x+=Math.max(1,Math.floor(w/24))){const i=(y*w+x)*4;samples.push([data[i],data[i+1],data[i+2]]);}
  const avg=samples.reduce((a,b)=>a.map((v,i)=>v+b[i]/samples.length),[0,0,0]);
  const variance=samples.reduce((a,p)=>a+(p[0]-avg[0])**2+(p[1]-avg[1])**2+(p[2]-avg[2])**2,0)/Math.max(1,samples.length);
  return {w,h,mask,bbox:{x:minX,y:minY,width:Math.max(1,maxX-minX+1),height:Math.max(1,maxY-minY+1)},fill,avg,variance,areaPixels:count};
}

function profileFromVisual(stats, detectorLabel, filename){
  const source=((detectorLabel||'')+' '+(filename||'')).toLowerCase();
  let best=null,bestScore=0;
  for(const p of PROFILES){let score=0;for(const k of p.keywords)if(source.includes(k))score+=4;if(p.label.test(source))score+=6;
    // Shape cues: tall objects, wide/flat objects, tiny elongated objects.
    const ar=stats.bbox.width/stats.bbox.height;
    if(p.name==='Rice Grain' && ar>2.0)score+=5;
    if(p.name==='Drink Can' && ar>.45&&ar<.75)score+=2;
    if((p.name==='Cup / Mug'||p.name==='Bottle')&&ar>.45&&ar<1.15)score+=1;
    if(p.name==='Book'&&ar>.8&&ar<1.5)score+=1;
    if(p.name==='Coin'&&Math.abs(ar-1)<.18&&stats.fill>.45)score+=2;
    if(score>bestScore){bestScore=score;best=p;}
  }
  return best||null;
}

async function identifyObject(stats){
  const fileName=($('#file').files[0]?.name||'');
  let detectorLabel=''; let detectorScore=0; let bboxFromDetector=null;
  try{
    const detector=await loadVisionDetector();
    if(detector){
      const result=await detector.detect((await imageToCanvas()).c);
      result.sort((a,b)=>b.score-a.score);
      if(result[0]&&result[0].score>.35){detectorLabel=result[0].class;detectorScore=result[0].score;bboxFromDetector=result[0].bbox;}
    }
  }catch(e){/* local heuristic fallback remains active */}
  let profile=profileFromVisual(stats,detectorLabel,fileName);
  // Explicitly recognize a photographed grain/rice-like object even when generic object detection cannot.
  const ar=stats.bbox.width/stats.bbox.height;
  const tinyObject=stats.fill<.38 || stats.bbox.width<stats.w*.28 || stats.bbox.height<stats.h*.28;
  const pale=stats.avg[0]>155 && stats.avg[1]>145 && stats.avg[2]>120;
  if(!profile && tinyObject && pale && ar>1.7) profile=PROFILES.find(p=>p.name==='Rice Grain');
  if(!profile) profile={name:"Unclassified Object",category:"General Object",material:"indeterminate material",models:["silhouette"],size:{min:[3,3,1],max:[30,30,20]},weight:[.01,2],value:[1,80],density:.35,keywords:[]};
  return {profile,detectorLabel,detectorScore,bboxFromDetector};
}

function inferCondition(stats){
  const v=Math.sqrt(stats.variance);
  if(v<25)return "Clean / lightly used";
  if(v<55)return "Good used condition";
  return "Used / visibly handled";
}

function inferMaterial(stats,profile){
  const a=stats.avg, v=Math.sqrt(stats.variance);
  let material=profile.material, confidence=profile.name==='Unclassified Object'?42:64;
  if(profile.name==='Rice Grain')return {material:'starchy plant grain (rice)',confidence:94};
  if(/metal|aluminum|steel/i.test(profile.material))return {material:profile.material,confidence:82};
  if(v<28 && a[0]>210 && a[1]>205 && a[2]>195)return {material:'ceramic / porcelain / glazed glass',confidence:78};
  if(v>75 && a[0]<90 && a[1]<100 && a[2]<110)return {material:'dark polymer / rubber',confidence:63};
  if(v>100)return {material:profile.material+'; visually mixed surface',confidence:Math.max(48,confidence-10)};
  return {material,confidence};
}

function numberFormat(n){
  if(n<.001)return n.toExponential(2);
  if(n<.01)return n.toFixed(4).replace(/0+$/,'').replace(/\.$/,'');
  if(n<1)return n.toFixed(2);
  return n.toFixed(1);
}

function chooseDimension(profile,stats){
  const p=profile;
  const ar=stats.bbox.width/Math.max(1,stats.bbox.height);
  const min=p.size.min,max=p.size.max;
  // For an elongated grain, model the long axis explicitly instead of using arbitrary centimeters.
  if(p.name==='Rice Grain')return {height:0.70,width:0.20,depth:0.16,mode:'biometric prior for rice grain'};
  // Height is the image's smaller/larger visual axis depending on shape; keep proportions locked to bbox.
  const targetLong=lerp(Math.max(...min),Math.max(...max),clamp((stats.fill*.65)+(Math.min(1,1/Math.max(ar,.15))*.2),0,1));
  const pxLong=Math.max(stats.bbox.width,stats.bbox.height);
  const pxShort=Math.min(stats.bbox.width,stats.bbox.height);
  let H,W,D;
  if(ar>=1){W=targetLong;H=targetLong*(pxShort/Math.max(1,pxLong));}
  else {H=targetLong;W=targetLong*(pxLong/Math.max(1,pxShort));}
  const physical=[clamp(H,min[0],max[0]),clamp(W,min[1],max[1])];
  H=physical[0];W=physical[1];
  D=lerp(min[2],max[2],clamp(stats.fill,.05,.95));
  return {height:H,width:W,depth:D,mode:'category-based scale prior'};
}

function applyScale(dim,bbox,canvasW,canvasH){
  if(!scaleReference)return {...dim,measurementMode:dim.mode};
  const p0=scaleReference.p0,p1=scaleReference.p1;
  const px=Math.hypot(p1.x-p0.x,p1.y-p0.y);
  const cm=scaleReference.cm;
  if(px<2)return {...dim,measurementMode:dim.mode};
  const pxPerCm=px/cm;
  const h=dim.height, w=dim.width;
  // bbox dimensions are in the analysis canvas coordinate system.
  const ratioX=bbox.width/px, ratioY=bbox.height/px;
  const out={height:ratioY*cm,width:ratioX*cm,depth:Math.min(ratioY,ratioX)*cm*.22,measurementMode:'calibrated from image reference'};
  if(dim.height<.01||dim.width<.01)return {...dim,measurementMode:dim.mode};
  return out;
}

function estimateWorth(profile,condition,stats){
  const [lo,hi]=profile.value; let t=clamp(.2+stats.fill*.45,0,1); let v=lerp(lo,hi,t);
  if(/clean|excellent/i.test(condition))v*=1.06; if(/used|handled/i.test(condition))v*=.84;
  // Rice is commodity-level value, not collectible-object value.
  if(profile.name==='Rice Grain')v=Math.min(.02,Math.max(.001,v));
  return {low:lo,high:hi,mid:v};
}

function buildAnalysis(stats,id){
  const p=id.profile;const dim0=chooseDimension(p,stats);const dim=applyScale(dim0,stats.bbox,stats.w,stats.h);

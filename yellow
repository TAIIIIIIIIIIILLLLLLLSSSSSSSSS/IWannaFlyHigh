  if(id.detectorScore)conf=Math.max(conf,Math.round(id.detectorScore*100));
  if(scaleReference)conf=Math.min(98,conf+12);
  return {
    name:p.name,category:p.category,model:p.models[0],height:numberFormat(dim.height)+(p.name==='Rice Grain'?' cm':' cm'),width:numberFormat(dim.width)+' cm',depth:numberFormat(dim.depth)+' cm',weight:numberFormat(kg)+' kg',material:mat.material,condition,worth:`$${worth.mid<1?worth.mid.toFixed(2):worth.mid.toFixed(0)}`,confidence:conf+'%',
    details:`${p.name} profile generated from pixel geometry${id.detectorLabel?' and browser vision detection':''}. Proportions follow the photographed silhouette. ${dim.measurementMode==='calibrated from image reference'?'Physical dimensions were scaled from your reference measurement.':'Absolute dimensions are inferred from a category prior; a photograph without a known reference cannot reveal real-world scale with precision.'}`,
    range:`Typical value band for this class: $${worth.low.toFixed(worth.low<1?2:0)}–$${worth.high.toFixed(worth.high<1?2:0)}`,
    measurementMode:dim.measurementMode,detectedBy:id.detectorLabel||'visual heuristics'
